{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "coverageAnalysis": "perTest",
  "disableTypeChecks": false,
  "tap": {
    "testFiles": [
      "tests/unit/audit-chain.test.mjs",
      "tests/unit/git-guard.test.mjs",
      "tests/unit/core.test.mjs",
      "tests/unit/adr-drift.test.mjs",
      "tests/unit/session.test.mjs",
      "tests/unit/arch-trace.test.mjs",
      "tests/unit/coverage-mutation.test.mjs",
      "tests/unit/triage-review.test.mjs"
    ],
    "forceBail": true
  },
  "mutate": [
    ".agent/scripts/lib/audit-chain.mjs",
    ".agent/scripts/lib/git-guard.mjs",
    ".agent/scripts/lib/core.mjs",
    ".agent/scripts/lib/adr-drift.mjs",
    ".agent/scripts/lib/session.mjs",
    ".agent/scripts/lib/arch-trace.mjs",
    ".agent/scripts/lib/coverage-mutation.mjs",
    ".agent/scripts/lib/triage-review.mjs"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 52
  },
  "reporters": ["clear-text", "json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "ignoreStatic": true,
  "concurrency": "75%",
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["reports", "coverage", ".impeccable"]
}
