{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "sdlc-node",
  "plugins": ["@stryker-mutator/tap-runner", "./tests/helpers/stryker-node-runner.mjs"],
  "coverageAnalysis": "perTest",
  "disableTypeChecks": false,
  "mutator": {
    "excludedMutations": ["StringLiteral", "Regex"]
  },
  "tap": {
    "nodeArgs": ["--test", "--test-isolation=none", "--test-reporter=tap"],
    "testFiles": [
      "tests/unit/config.test.mjs",
      "tests/unit/install.test.mjs",
      "tests/unit/git.test.mjs",
      "tests/unit/drift.test.mjs",
      "tests/unit/guard.test.mjs",
      "tests/unit/receipt.test.mjs",
      "tests/unit/cli.test.mjs",
      "tests/unit/measure.test.mjs"
    ],
    "forceBail": true
  },
  "mutate": [
    ".agent/scripts/lib/git.mjs",
    ".agent/scripts/lib/config.mjs",
    ".agent/scripts/lib/receipt.mjs",
    ".agent/scripts/lib/drift.mjs",
    ".agent/scripts/lib/measure.mjs",
    ".agent/scripts/lib/guard.mjs",
    ".agent/scripts/lib/install.mjs",
    ".agent/scripts/sdlc-engine.mjs"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 52
  },
  "reporters": ["clear-text", "json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "ignoreStatic": true,
  "timeoutMS": 5000,
  "timeoutFactor": 1.5,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["reports", "coverage", ".agent/.cache"]
}
