# Charmbracelet VHS Declarative Hero Proof — sealit (sealit.dev)
# Generate docs/demo.gif with: vhs docs/demo.tape
Output docs/demo.gif
Set FontSize 15
Set Width 940
Set Height 440
Set Padding 24
Set TypingSpeed 40ms

Type "npx --yes github:fmatar/sealit init --agents antigravity,claude,cursor --yes"
Enter
Sleep 3s
Type "node .agent/scripts/sealit-engine.mjs doctor"
Enter
Sleep 4s
