{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fmatar/agentic-sdlc-framework/main/.agent/schemas/sdlc-config.schema.json",
  "title": "Agentic SDLC Alignment + Proof Kernel Configuration (v0.1.0)",
  "description": "Repository configuration for @fmatar/agentic-sdlc v0.1.0 modules, test/coverage/mutation commands, thresholds, CI checks, Archlens ring policy, and audited mutant exemptions.",
  "type": "object",
  "required": ["version", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ci": {
      "type": "object",
      "properties": {
        "runsOn": {
          "oneOf": [
            { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$" }
            }
          ]
        },
        "checkName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "archlens": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "policyPath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "commands"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "language": { "type": "string" },
          "stack": { "type": "string", "deprecated": true },
          "commands": {
            "type": "object",
            "properties": {
              "lint": { "$ref": "#/$defs/commandSpec" },
              "build": { "$ref": "#/$defs/commandSpec" },
              "test": { "$ref": "#/$defs/commandSpec" },
              "coverage": { "$ref": "#/$defs/commandSpec" },
              "coverageFile": { "type": ["string", "null"] },
              "mutation": { "$ref": "#/$defs/commandSpec" }
            },
            "additionalProperties": false
          },
          "thresholds": {
            "type": "object",
            "properties": {
              "diffCoverage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "mutationScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "reason", "addedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 5 },
          "addedAt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "gates": { "type": "object", "deprecated": true },
    "testing": { "type": "object", "deprecated": true },
    "lanes": { "type": "object", "deprecated": true },
    "projectManagement": { "type": "object", "deprecated": true },
    "profile": { "type": "string", "deprecated": true },
    "generatedAt": { "type": "string", "deprecated": true }
  },
  "$defs": {
    "commandSpec": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      ]
    }
  },
  "additionalProperties": false
}
