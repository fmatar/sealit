{
  "$schema": "https://agentic-sdlc.dev/schemas/config.v1.json",
  "version": "1.0.0",
  "profile": "framework-distribution",
  "modules": [
    {
      "name": "agentic-sdlc-framework",
      "path": ".",
      "stack": "nodejs-engine",
      "language": "javascript",
      "commands": {
        "test": "node --test tests/sdlc-engine.test.mjs",
        "coverage": "node --test tests/sdlc-engine.test.mjs",
        "coverageFile": "coverage/coverage-summary.json",
        "mutation": "node --test tests/sdlc-engine.test.mjs",
        "lint": "git diff --check",
        "build": "node .agent/scripts/sdlc-engine.mjs detect"
      },
      "thresholds": {
        "diffCoverage": 85,
        "mutationScore": 80
      }
    }
  ]
}