{
  "$schema": "./schemas/sdlc-config.schema.json",
  "version": "0.1.0",
  "ci": {
    "runsOn": "${{ vars.SDLC_RUNS_ON || 'ubuntu-latest' }}",
    "checkName": "Universal Quality Gate, Spec-Drift & Merkle Receipt Defense"
  },
  "archlens": {
    "enabled": true,
    "policyPath": ".archlens/policy.json"
  },
  "modules": [
    {
      "name": "root",
      "path": ".",
      "language": "javascript",
      "commands": {
        "lint": "npm run --silent lint",
        "build": null,
        "test": "node --test --test-reporter=dot \"tests/**/*.test.mjs\"",
        "coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=dot --test-reporter-destination=stdout \"tests/**/*.test.mjs\"",
        "coverageFile": "coverage/lcov.info",
        "mutation": "./node_modules/.bin/stryker run"
      },
      "thresholds": {
        "diffCoverage": 85,
        "mutationScore": 52
      }
    }
  ],
  "exemptions": []
}
