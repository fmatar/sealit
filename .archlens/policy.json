    ],
    [
      ".agent/scripts/lib/arch-trace.mjs",
      ".agent/scripts/lib/installer.mjs",
      ".agent/scripts/lib/wiki-sync.mjs",
      ".agent/scripts/lib/workbench-server.mjs",
