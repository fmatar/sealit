{
  "title": "agentic-sdlc-framework",
  "src": ".agent/scripts",
  "prefix": "",
  "hierarchical": true,
  "layers": [
    {
      "name": "domain-core",
      "paths": [
        ".agent/scripts/lib/core.mjs",
        ".agent/scripts/lib/cache.mjs",
        ".agent/scripts/lib/audit-chain.mjs",
        ".agent/scripts/lib/decision-graph.mjs"
      ],
      "allowedDependencies": []
    },
    {
      "name": "governance-models",
      "paths": [
        ".agent/scripts/lib/pm-provider.mjs",
        ".agent/scripts/lib/adr-drift.mjs",
        ".agent/scripts/lib/product-dag.mjs",
        ".agent/scripts/lib/dossier.mjs",
        ".agent/scripts/lib/readme-sync.mjs",
        ".agent/scripts/lib/git-guard.mjs"
      ],
      "allowedDependencies": [
        "domain-core"
      ]
    },
    {
      "name": "adapters-orchestrators",
      "paths": [
        ".agent/scripts/lib/arch-trace.mjs",
        ".agent/scripts/lib/installer.mjs",
        ".agent/scripts/lib/wiki-sync.mjs",
        ".agent/scripts/lib/workbench-server.mjs",
        ".agent/scripts/lib/quality-gate.mjs",
        ".agent/scripts/lib/session.mjs"
      ],
      "allowedDependencies": [
        "domain-core",
        "governance-models"
      ]
    },
    {
      "name": "cli-entrypoints",
      "paths": [
        ".agent/scripts/sdlc-engine.mjs"
      ],
      "allowedDependencies": [
        "domain-core",
        "governance-models",
        "adapters-orchestrators"
      ]
    }
  ],
  "foreign": [
    "node:",
    "@types/"
  ],
  "omit": [
    "target",
    "build",
    ".git",
    "node_modules",
    "coverage",
    "reports",
    ".stryker-tmp",
    ".impeccable",
    ".gradle",
    ".idea",
    ".vscode"
  ],
  "lang": "javascript"
}
