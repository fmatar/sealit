{
  "name": "sealit",
  "version": "0.0.1",
  "description": "Alignment and Proof Kernel for AI Coding Agents: Spec/ADR Drift Guard, Diff Coverage & Mutation Gate, and Cryptographic Merge Receipts",
  "keywords": [
    "sealit",
    "ai-agents",
    "skills",
    "tdd",
    "code-coverage",
    "mutation-testing",
    "clean-architecture",
    "git-hooks"
  ],
  "author": "Fadi Matar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmatar/sealit.git"
  },
  "homepage": "https://sealit.dev",
  "bugs": {
    "url": "https://github.com/fmatar/sealit/issues"
  },
  "type": "module",
  "main": "./.agent/scripts/sealit-engine.mjs",
  "exports": {
    ".": "./.agent/scripts/sealit-engine.mjs",
    "./lib/*": "./.agent/scripts/lib/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "sealit": "bin/sealit.mjs"
  },
  "files": [
    "bin",
    ".agent/skills/sealit",
    ".agent/skills/sealit-spec",
    ".agent/skills/sealit-adr",
    ".agent/skills/sealit-tdd",
    ".agent/skills/sealit-gate",
    ".agent/skills/sealit-flow",
    ".agent/scripts",
    ".agent/schemas",
    "docs/logo-dark.svg",
    "docs/logo-light.svg",
    "docs/templates",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "lint": "node --check bin/sealit.mjs .agent/scripts/sealit-engine.mjs .agent/scripts/lib/*.mjs tests/helpers/*.mjs tests/unit/*.mjs",
    "test": "node --test --test-reporter=dot \"tests/**/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=dot \"tests/unit/*.test.mjs\"",
    "test:affected": "node .agent/scripts/sealit-engine.mjs test --affected-only",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=dot --test-reporter-destination=stdout \"tests/**/*.test.mjs\"",
    "coverage": "node .agent/scripts/sealit-engine.mjs coverage",
    "mutation": "node .agent/scripts/sealit-engine.mjs mutation",
    "gate": "node .agent/scripts/sealit-engine.mjs gate",
    "drift": "node .agent/scripts/sealit-engine.mjs drift",
    "doctor": "node .agent/scripts/sealit-engine.mjs doctor",
    "verify": "node .agent/scripts/sealit-engine.mjs verify",
    "hooks:install": "node .agent/scripts/sealit-engine.mjs hooks install"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/tap-runner": "^9.6.1"
  }
}
