# ==============================================================================
# Agentic SDLC v0.1.0 Environment Variables Configuration
# Copy this file to .env for local or CI overrides (never commit .env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Stage 7 Cryptographic Receipt Signing Key (CI / Shared Verification)
# ------------------------------------------------------------------------------
# Locally, sdlc-engine provisions .agent/.receipt-key (0600, gitignored).
# In CI, configure repository secret SDLC_RECEIPT_KEY with that exact value:
#   tr -d '\r\n' < .agent/.receipt-key | gh secret set SDLC_RECEIPT_KEY
SDLC_RECEIPT_KEY=

# ------------------------------------------------------------------------------
# 2. Clean Architecture Companion (Archlens)
# ------------------------------------------------------------------------------
ARCHLENS_PORT=8088
ARCHLENS_POLICY_PATH=.archlens/policy.json
