# ==============================================================================
# Agentic SDLC Framework Environment Variables Configuration
# Copy this file to .env and configure the credentials for your project.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project Management Providers (Choose one or more)
# ------------------------------------------------------------------------------

# --- GitHub (Default) ---
# Required for GitHub Projects v2, PR creation, issue automation, and github-mcp-server
# Token scopes needed: repo, project, read:project, workflow
GITHUB_TOKEN=

# --- Jira (Atlassian) ---
# Required when using Jira as the PM provider or with jira-mcp-server
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=developer@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SDLC

# --- Linear ---
# Required when using Linear as the PM provider or with linear-mcp-server
LINEAR_API_KEY=
LINEAR_TEAM_KEY=ENG

# --- GitLab ---
# Required when using GitLab issues & merge requests
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# ------------------------------------------------------------------------------
# 2. Architecture & Governance (Archlens)
# ------------------------------------------------------------------------------
# Port for Archlens dynamic visual workbench (Default: 8088)
ARCHLENS_PORT=8088
# Path to Archlens policy file (Default: .archlens/policy.json)
ARCHLENS_POLICY_PATH=.archlens/policy.json

# ------------------------------------------------------------------------------
# 3. SDLC Quality Gate & Mutation Testing Thresholds
# ------------------------------------------------------------------------------
# Minimum line/branch diff coverage percentage (Default: 85)
SDLC_COVERAGE_THRESHOLD=85
# Minimum mutation kill score percentage (Default: 80)
SDLC_MUTATION_THRESHOLD=80
